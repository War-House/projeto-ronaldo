# Variáveis de ambiente do WarHouse. Todas têm valor padrão no código: o projeto roda SEM .env.
# Se precisar mudar algo, copie para .env (o .env nunca vai para o GitHub) ou defina no terminal.
# Valores abaixo são de EXEMPLO / FICTÍCIOS.

# Endereço do RabbitMQ (API REST e consumidores)
RABBITMQ_URL=amqp://localhost:5672

# Onde o gateway e o GraphQL encontram os serviços internos
REST_URL=http://127.0.0.1:3001
GRAPHQL_URL=http://127.0.0.1:4000
LOGISTICA_URL=http://127.0.0.1:3003

# Interface de escuta dos serviços internos (127.0.0.1 = só a própria máquina)
HOST=127.0.0.1

# Chaves de API da demonstração (fictícias; ficam em gateway/app.js, como no tutorial)
# app-cliente:        chave-app-cliente-123        (30 req/min)
# painel-admin:       chave-painel-admin-456       (120 req/min)
# parceiro-ludoteca:  chave-parceiro-ludoteca-789  (10 req/min)
